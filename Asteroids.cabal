
name:                asteroids
version:             0.1.0.0
author:              Bram
category:            Game
build-type:          Simple
cabal-version:       >=1.10

executable asteroids
  main-is:             Main.hs
  build-depends:       base >= 4 && < 5,
                       gloss,
                       random,
                       directory
  hs-source-dirs:      src
  other-modules:       Controller
                     , Model
                     , Ship
                     , Asteroids
                     , Bullet
                     , Collision
                     , View
                     , HighScore
  default-language:    Haskell2010
  ghc-options:         -Wall
